{
  "name": "mochi",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-themes.mjs && node scripts/check-token-usage.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check:themes": "node scripts/check-themes.mjs",
    "check:tokens": "node scripts/check-token-usage.mjs",
    "audit:layout": "node scripts/layout-audit.mjs",
    "test:metadata": "node --test scripts/metadata.test.mjs",
    "test:mods": "node --test scripts/mods.test.mjs",
    "build:launcher-art": "node scripts/build-launcher-art.mjs",
    "lint": "eslint src",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run && npm run test:metadata && npm run test:mods"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-deep-link": "^2.6.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.2",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "simple-icons": "^16.34.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
