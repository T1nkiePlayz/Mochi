{
  "schemaVersion": 1,
  "id": "minecraft-ore",
  "name": "Minecraft Ore",
  "version": "4.0.0",
  "soundPack": "chiptune",
  "order": 3,
  "author": "Mochi",
  "description": "Ore UI Dark Diamond: charcoal panels, bevelled stone buttons and a diamond-blue toolbar, after Prism Launcher's Ore UI.",
  "scheme": "dark",
  "shell": "top",
  "fonts": [
    "https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@500;600;700&family=Noto+Sans:wght@400;500;600;700&display=swap"
  ],
  "colors": {
    "background": "#1C1D1D",
    "backgroundElevated": "#2A2B2C",
    "surface": "#2A2B2C",
    "surfaceRaised": "#39393B",
    "surfaceHover": "#47484A",
    "border": "#0E0E0F",
    "borderStrong": "#39393B",
    "text": "#E6E6E7",
    "textStrong": "#FFFFFF",
    "textMuted": "#A8A9AB",
    "textFaint": "#939496",
    "accent": "#6290ed",
    "accentStrong": "#336ee7",
    "accentText": "#FFFFFF",
    "accentSoft": "rgba(46,107,230,.22)",
    "success": "#9CD78C",
    "warning": "#FDDC69",
    "danger": "#EF7C7C",
    "shadow": "rgba(0,0,0,.55)"
  },
  "ui": {
    "fontBody": "\"Noto Sans\", \"DM Sans\", sans-serif",
    "fontDisplay": "\"Pixelify Sans\", \"Noto Sans\", sans-serif",
    "radiusSm": "0px",
    "radiusMd": "0px",
    "radiusLg": "0px",
    "pillRadius": "0px",
    "heroRadius": "0px",
    "topbarHeight": "58px",
    "contentMaxWidth": "1320px",
    "contentPadding": "26px 32px 24px"
  },
  "typography": {
    "headingWeight": "600",
    "headingTracking": "0",
    "labelWeight": "700",
    "labelTracking": ".06em",
    "bodyLineHeight": "1.5"
  },
  "layout": {
    "cardGap": "12px"
  },
  "effects": {
    "blur": "0px",
    "transition": "90ms linear",
    "shadowSoft": "none",
    "shadowCard": "none"
  },
  "components": {
    "buttonHeight": "36px",
    "inputHeight": "36px",
    "borderWidth": "2px",
    "appBackground": "var(--mochi-background)",
    "sidebarBackground": "var(--mochi-surface)",
    "sidebarBorder": "#0E0E0F",
    "topbarBorder": "#0E0E0F",
    "buttonBackground": "#39393B",
    "buttonBorder": "#0E0E0F",
    "buttonHoverBackground": "#47484A",
    "buttonHoverBorder": "#0E0E0F",
    "buttonShadow": "inset 0 0 0 2px #47484A, inset 0 -4px 0 0 #2A2B2C",
    "primaryBackground": "#1855D1",
    "primaryColor": "#FFFFFF",
    "primaryBorder": "#0E0E0F",
    "primaryHoverBackground": "#1855D1",
    "primaryShadow": "inset 0 0 0 2px #2E6BE6, inset 0 -4px 0 0 #001F5C",
    "cardBackground": "#2A2B2C",
    "cardHoverBackground": "#2A2B2C",
    "cardBorder": "#0E0E0F",
    "cardHoverBorder": "#0E0E0F",
    "cardShadow": "inset 0 0 0 2px #39393B",
    "panelBackground": "#2A2B2C",
    "panelBorder": "#0E0E0F",
    "panelShadow": "inset 0 0 0 2px #39393B",
    "modalBackground": "#2A2B2C",
    "modalBorder": "#0E0E0F",
    "modalShadow": "inset 0 0 0 2px #39393B, 0 24px 60px rgba(0,0,0,.6)",
    "inputBackground": "#131314",
    "inputBorder": "#656565",
    "inputFocusBorder": "#2E6BE6",
    "inputShadow": "inset 0 4px 0 0 #0A0A0B",
    "navActiveBackground": "#1855D1",
    "navActiveShadow": "inset 0 0 0 2px #2E6BE6, inset 0 -4px 0 0 #001F5C",
    "navHoverBackground": "#47484A",
    "focusRing": "0 0 0 2px #2E6BE6",
    "overlayBackground": "rgba(8,8,9,.72)",
    "heroOverlay": "linear-gradient(180deg, transparent 30%, rgba(14,14,15,.9))",
    "scrollbarThumb": "#47484A",
    "scrollbarTrack": "#131314",
    "scrollbarWidth": "14px"
  },
  "icons": {
    "library": "assets/icons-library.svg",
    "installed": "assets/icons-installed.svg",
    "discover": "assets/icons-discover.svg",
    "downloads": "assets/icons-downloads.svg",
    "play": "assets/icons-play.svg",
    "plus": "assets/icons-plus.svg",
    "search": "assets/icons-search.svg",
    "settings": "assets/icons-settings.svg",
    "manage": "assets/icons-manage.svg",
    "palette": "assets/icons-palette.svg",
    "folder": "assets/icons-folder.svg",
    "refresh": "assets/icons-refresh.svg",
    "security": "assets/icons-security.svg",
    "key": "assets/icons-key.svg",
    "github": "assets/icons-github.svg",
    "close": "assets/icons-close.svg",
    "chevron": "assets/icons-chevron.svg",
    "more": "assets/icons-more.svg",
    "gamepad": "assets/icons-gamepad.svg",
    "cloud": "assets/icons-cloud.svg",
    "notifications": "assets/icons-notifications.svg",
    "account": "assets/icons-account.svg",
    "menu": "assets/icons-menu.svg",
    "themeFile": "assets/icons-theme-file.svg",
    "offline": "assets/icons-offline.svg"
  },
  "assets": {
    "brand": "assets/ore.svg"
  }
}