{
  "schemaVersion": 1,
  "id": "minecraft-ore",
  "name": "Minecraft Ore",
  "version": "3.0.0",
  "author": "Side Quest Games",
  "description": "Ore UI-inspired Minecraft theme with compact pixel panels, hard edges, deep stone surfaces and custom Minecraft-style icons.",
  "colors": {
    "background": "#101010",
    "backgroundElevated": "#171717",
    "surface": "#202020",
    "surfaceRaised": "#292929",
    "surfaceHover": "#343434",
    "border": "#454545",
    "borderStrong": "#666666",
    "text": "#e7e7e7",
    "textStrong": "#ffffff",
    "textMuted": "#a7a7a7",
    "textFaint": "#727272",
    "accent": "#7ed321",
    "accentStrong": "#9be84f",
    "accentText": "#101508",
    "accentSoft": "rgba(126,211,33,.15)",
    "success": "#86d34f",
    "warning": "#e4b34c",
    "danger": "#e26b5e",
    "shadow": "rgba(0,0,0,.58)"
  },
  "ui": {
    "fontBody": "Inter, \"DM Sans\", sans-serif",
    "fontDisplay": "Inter, \"DM Sans\", sans-serif",
    "radiusSm": "2px",
    "radiusMd": "3px",
    "radiusLg": "4px",
    "sidebarWidth": "232px",
    "contentMaxWidth": "1220px",
    "density": "1"
  },
  "typography": {
    "bodyLineHeight": "1.42",
    "headingWeight": "800",
    "labelWeight": "800",
    "mono": "\"JetBrains Mono\", monospace"
  },
  "layout": {
    "contentPadding": "34px 44px 24px",
    "topbarHeight": "62px",
    "cardGap": "9px",
    "sectionGap": "24px"
  },
  "effects": {
    "shadowSoft": "0 2px 0 rgba(0,0,0,.28)",
    "shadowCard": "0 3px 0 rgba(0,0,0,.28), 0 12px 28px rgba(0,0,0,.25)",
    "blur": "0px",
    "transition": "90ms steps(2,end)"
  },
  "components": {
    "buttonHeight": "34px",
    "inputHeight": "34px",
    "cardRadius": "2px",
    "heroRadius": "3px",
    "glass": "#1a1a1a"
  },
  "icons": {
    "library": "assets/icons-library.svg",
    "installed": "assets/icons-installed.svg",
    "discover": "assets/icons-discover.svg",
    "downloads": "assets/icons-downloads.svg",
    "play": "assets/icons-play.svg",
    "plus": "assets/icons-plus.svg",
    "search": "assets/icons-search.svg",
    "settings": "assets/icons-settings.svg",
    "manage": "assets/icons-manage.svg",
    "palette": "assets/icons-palette.svg",
    "folder": "assets/icons-folder.svg",
    "refresh": "assets/icons-refresh.svg",
    "security": "assets/icons-security.svg",
    "key": "assets/icons-key.svg",
    "github": "assets/icons-github.svg",
    "close": "assets/icons-close.svg",
    "chevron": "assets/icons-chevron.svg",
    "more": "assets/icons-more.svg",
    "gamepad": "assets/icons-gamepad.svg",
    "cloud": "assets/icons-cloud.svg",
    "notifications": "assets/icons-notifications.svg",
    "account": "assets/icons-account.svg",
    "menu": "assets/icons-menu.svg",
    "themeFile": "assets/icons-theme-file.svg",
    "offline": "assets/icons-offline.svg"
  },
  "assets": {
    "brand": "assets/ore.svg"
  }
}
