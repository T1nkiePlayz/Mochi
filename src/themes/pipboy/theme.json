{
  "schemaVersion": 1,
  "id": "pipboy",
  "name": "Fallout Pip-Boy",
  "version": "1.0.0",
  "soundPack": "chiptune",
  "order": 8,
  "author": "Mochi",
  "description": "A phosphor-green CRT terminal: scanlines, bracketed controls, monochrome cover art and tabs across the top.",
  "scheme": "dark",
  "shell": "top",
  "fonts": [
    "https://fonts.googleapis.com/css2?family=VT323&display=swap"
  ],
  "colors": {
    "background": "#020d05",
    "backgroundElevated": "#03140a",
    "surface": "#041a0c",
    "surfaceRaised": "#07270f",
    "surfaceHover": "#0b3a17",
    "border": "#0f7a36",
    "borderStrong": "#1bb556",
    "text": "#2bff7a",
    "textStrong": "#8dffb7",
    "textMuted": "#17b04f",
    "textFaint": "#0e7a35",
    "accent": "#2bff7a",
    "accentStrong": "#6dffa3",
    "accentText": "#021006",
    "accentSoft": "rgba(43,255,122,.14)",
    "success": "#2bff7a",
    "warning": "#ffd23a",
    "danger": "#ff6a3a",
    "shadow": "rgba(0,40,10,.8)"
  },
  "ui": {
    "fontBody": "\"VT323\", ui-monospace, monospace",
    "fontDisplay": "\"VT323\", ui-monospace, monospace",
    "radiusSm": "0px",
    "radiusMd": "0px",
    "pillRadius": "0px",
    "radiusLg": "0px",
    "heroRadius": "0px",
    "contentMaxWidth": "1240px",
    "topbarHeight": "54px"
  },
  "typography": {
    "headingWeight": "400",
    "headingTracking": ".06em",
    "headingTransform": "uppercase",
    "labelWeight": "400",
    "labelTracking": ".16em",
    "bodyLineHeight": "1.25",
    "textShadow": "0 0 6px rgba(43,255,122,.55)",
    "headingShadow": "0 0 10px rgba(43,255,122,.8)",
    "mono": "\"VT323\", monospace"
  },
  "effects": {
    "blur": "0px",
    "transition": "60ms steps(2)"
  },
  "components": {
    "buttonHeight": "36px",
    "borderWidth": "1px",
    "buttonWeight": "400",
    "buttonTransform": "uppercase",
    "buttonTracking": ".1em",
    "appBackground": "radial-gradient(ellipse at center, #03200e 0%, #020d05 75%)",
    "sidebarBackground": "#020d05",
    "sidebarBorder": "#1bb556",
    "topbarBorder": "#0f7a36",
    "buttonBackground": "transparent",
    "buttonBorder": "transparent",
    "buttonColor": "#2bff7a",
    "buttonShadow": "none",
    "buttonHoverBackground": "#2bff7a",
    "buttonHoverBorder": "transparent",
    "primaryBackground": "#2bff7a",
    "primaryColor": "#021006",
    "primaryBorder": "transparent",
    "primaryShadow": "0 0 14px rgba(43,255,122,.55)",
    "primaryHoverBackground": "#8dffb7",
    "dangerBackground": "transparent",
    "dangerColor": "#ff6a3a",
    "cardBackground": "rgba(4,26,12,.6)",
    "cardHoverBackground": "#0b3a17",
    "cardBorder": "#0f7a36",
    "cardHoverBorder": "#2bff7a",
    "cardShadow": "none",
    "panelBackground": "rgba(4,26,12,.6)",
    "panelBorder": "#0f7a36",
    "panelShadow": "none",
    "modalBackground": "#020d05",
    "modalBorder": "#2bff7a",
    "modalShadow": "0 0 30px rgba(43,255,122,.35)",
    "inputBackground": "#020d05",
    "inputBorder": "#0f7a36",
    "inputFocusBorder": "#2bff7a",
    "inputShadow": "inset 0 0 10px rgba(43,255,122,.1)",
    "navActiveBackground": "#2bff7a",
    "navActiveShadow": "none",
    "navHoverBackground": "rgba(43,255,122,.16)",
    "overlayBackground": "rgba(1,8,3,.85)",
    "heroOverlay": "linear-gradient(180deg, transparent 30%, rgba(2,13,5,.92))",
    "scrollbarThumb": "#1bb556",
    "scrollbarTrack": "#03140a",
    "scrollbarWidth": "12px",
    "focusRing": "0 0 0 1px #2bff7a, 0 0 10px rgba(43,255,122,.6)"
