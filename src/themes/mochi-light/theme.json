{
  "schemaVersion": 1,
  "id": "mochi-light",
  "name": "Mochi Light",
  "version": "1.0.0",
  "author": "Side Quest Games",
  "description": "A bright Mochi theme with warm surfaces, soft mint accents and comfortable contrast.",
  "colors": {
    "background": "#f4f7f5",
    "backgroundElevated": "#ffffff",
    "surface": "#ffffff",
    "surfaceRaised": "#f7faf8",
    "surfaceHover": "#edf3ef",
    "border": "#d9e3dd",
    "borderStrong": "#bdcdc3",
    "text": "#34423a",
    "textStrong": "#18231e",
    "textMuted": "#718078",
    "textFaint": "#9aa9a1",
    "accent": "#4f9271",
    "accentStrong": "#3d7e5f",
    "accentText": "#ffffff",
    "accentSoft": "rgba(79,146,113,.11)",
    "success": "#39815b",
    "warning": "#a87324",
    "danger": "#b9574d",
    "shadow": "rgba(30,55,43,.14)"
  },
  "ui": {
    "fontBody": ""DM Sans", sans-serif",
    "fontDisplay": ""Manrope", sans-serif",
    "radiusSm": "8px",
    "radiusMd": "12px",
    "radiusLg": "18px",
    "sidebarWidth": "246px",
    "contentMaxWidth": "1160px",
    "density": "1"
  },
  "typography": {
    "bodyLineHeight": "1.55",
    "headingWeight": "800",
    "labelWeight": "700",
