{
  "schemaVersion": 1,
  "id": "dungeons",
  "name": "Minecraft Dungeons",
  "version": "3.0.0",
  "author": "Side Quest Games",
  "description": "Minecraft Dungeons with the compact, hard-edged Ore interface and a cool blue dungeon palette.",
  "colors": {
    "background": "#0c1018",
    "backgroundElevated": "#141a25",
    "surface": "#1b2432",
    "surfaceRaised": "#263246",
    "surfaceHover": "#33425a",
    "border": "#465873",
    "borderStrong": "#637b9d",
    "text": "#e9f0f8",
    "textStrong": "#ffffff",
    "textMuted": "#aebdd0",
    "textFaint": "#718197",
    "accent": "#5fa8ff",
    "accentStrong": "#8cc4ff",
    "accentText": "#07111d",
    "accentSoft": "rgba(95,168,255,.16)",
    "success": "#78cf9a",
    "warning": "#e7bd68",
    "danger": "#e27878",
    "shadow": "rgba(0,0,0,.58)"
  },
  "ui": {
    "fontBody": "Inter, \"DM Sans\", sans-serif",
    "fontDisplay": "Inter, \"DM Sans\", sans-serif",
    "radiusSm": "2px",
    "radiusMd": "3px",
    "radiusLg": "4px",
    "sidebarWidth": "232px",
    "contentMaxWidth": "1220px",
    "density": "1"
  },
  "typography": {
    "bodyLineHeight": "1.42",
    "headingWeight": "800",
    "labelWeight": "800",
    "mono": "\"JetBrains Mono\", monospace"
  },
  "layout": {
    "contentPadding": "34px 44px 24px",
    "topbarHeight": "62px",
    "cardGap": "9px",
    "sectionGap": "24px"
  },
  "effects": {
    "shadowSoft": "0 2px 0 rgba(0,0,0,.28)",
    "shadowCard": "0 3px 0 rgba(0,0,0,.28), 0 12px 28px rgba(0,0,0,.25)",
    "blur": "0px",
    "transition": "90ms steps(2,end)"
  },
  "components": {
    "buttonHeight": "34px",
    "inputHeight": "34px",
    "cardRadius": "2px",
    "heroRadius": "3px",
    "glass": "#1a1a1a"
  },
  "icons": {
    "library": "assets/icons-library.svg",
    "settings": "assets/icons-settings.svg",
    "play": "assets/icons-play.svg",
    "plus": "assets/icons-plus.svg",
    "mods": "assets/icons-mods.svg"
  }
}