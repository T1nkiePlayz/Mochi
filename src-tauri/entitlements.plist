<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Deliberately minimal. The web view runs in Apple's own WebContent process, so Mochi needs no
    JIT or unsigned-memory entitlement, and games are separate processes that library
    validation does not apply to. If a notarized build ever fails to start, see docs/macos.md.
  -->
  <key>com.apple.security.network.client</key><true/>
</dict>
</plist>
