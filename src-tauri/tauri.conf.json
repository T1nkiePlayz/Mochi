{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mochi",
  "version": "0.1.0",
  "identifier": "dev.sidequestgames.Mochilauncher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mochi — Your games, your way.",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "useHttpsScheme": true,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$CONFIG/Mochi/game-artwork/**"
        ]
      },
      "csp": {
        "default-src": [
          "'self'"
        ],
        "script-src": [
          "'self'"
        ],
        "worker-src": [
          "blob:"
        ],
        "style-src": [
          "'self'",
          "'unsafe-inline'",
          "https://fonts.googleapis.com"
        ],
        "font-src": [
          "'self'",
          "data:",
          "https://fonts.gstatic.com"
        ],
        "img-src": [
          "'self'",
          "data:",
          "blob:",
          "asset:",
          "http://asset.localhost",
          "https://images.igdb.com",
          "https://cdn2.steamgriddb.com",
          "https://*.steamgriddb.com",
          "https://*.steamstatic.com",
          "https://steamcdn-a.akamaihd.net",
          "https://cdn.modrinth.com",
          "https://staticdelivery.nexusmods.com",
          "https://images.nexusmods.com",
          "https://*.forgecdn.net",
          "https://lh3.googleusercontent.com",
          "https://avatars.githubusercontent.com",
          "https://*.modrinth.com",
          "https://cdn.discordapp.com",
          "https://*.googleusercontent.com",
          "https://secure.gravatar.com",
          "https://static-cdn.jtvnw.net",
          "https://gitlab.com",
          "https://*.supabase.co",
          "https://www.gravatar.com",
          "https://cdn.simpleicons.org",
          "https://raw.githubusercontent.com"
        ],
        "media-src": [
          "'self'",
          "data:",
          "blob:",
          "https://video.akamai.steamstatic.com",
          "https://video.cloudflare.steamstatic.com"
        ],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "https://*.supabase.co",
          "wss://*.supabase.co",
          "https://api.modrinth.com",
          "https://api.nexusmods.com",
          "https://api.github.com"
        ],
        "frame-src": [
          "https://www.youtube.com",
          "https://www.youtube-nocookie.com",
          "http://127.0.0.1:*"
        ],
        "object-src": [
          "'none'"
        ],
        "base-uri": [
          "'self'"
        ],
        "form-action": [
          "'self'"
        ]
      },
      "devCsp": {
        "default-src": [
          "'self'"
        ],
        "script-src": [
          "'self'",
          "'unsafe-inline'"
        ],
        "style-src": [
          "'self'",
          "'unsafe-inline'",
          "https://fonts.googleapis.com"
        ],
        "font-src": [
          "'self'",
          "data:",
          "https://fonts.gstatic.com"
        ],
        "img-src": [
          "'self'",
          "data:",
          "blob:",
          "asset:",
          "http://asset.localhost",
          "https://images.igdb.com",
          "https://cdn2.steamgriddb.com",
          "https://*.steamgriddb.com",
          "https://*.steamstatic.com",
          "https://steamcdn-a.akamaihd.net",
          "https://cdn.modrinth.com",
          "https://staticdelivery.nexusmods.com",
          "https://images.nexusmods.com",
          "https://*.forgecdn.net",
          "https://lh3.googleusercontent.com",
          "https://avatars.githubusercontent.com",
          "https://*.modrinth.com",
          "https://cdn.discordapp.com",
          "https://*.googleusercontent.com",
          "https://secure.gravatar.com",
          "https://static-cdn.jtvnw.net",
          "https://gitlab.com",
          "https://*.supabase.co",
          "https://www.gravatar.com",
          "https://cdn.simpleicons.org",
          "https://raw.githubusercontent.com",
          "http://localhost:5173"
        ],
        "media-src": [
          "'self'",
          "data:",
          "blob:",
          "https://video.akamai.steamstatic.com",
          "https://video.cloudflare.steamstatic.com"
        ],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "https://*.supabase.co",
          "wss://*.supabase.co",
          "https://api.modrinth.com",
          "https://api.nexusmods.com",
          "https://api.github.com",
          "http://localhost:5173",
          "ws://localhost:5173"
        ],
        "frame-src": [
          "https://www.youtube.com",
          "https://www.youtube-nocookie.com",
          "http://127.0.0.1:*"
        ],
        "object-src": [
          "'none'"
        ],
        "base-uri": [
          "'self'"
        ],
        "form-action": [
          "'self'"
        ]
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    },
    "appDirectoriesOverride": {
      "config": "$CONFIG/Mochi"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "Your games, your way.",
    "longDescription": "Mochi is a local-first game launcher that organises games from Steam, Heroic, Lutris, Bottles, itch.io, Flatpak and more in one library, with optional cloud metadata sync.",
    "linux": {
      "deb": {
        "section": "games",
        "depends": [
          "libudev1",
          "xdg-utils",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good"
        ],
        "recommends": [
          "libnotify-bin"
        ]
      },
      "rpm": {
        "release": "1",
        "depends": [
          "libudev.so.1()(64bit)",
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "mochi",
          "nxm"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFMTZBRjA4NUU0MEUzQzkKUldUSjQwQmVDSzhXcnV0TTFtdm9uNHEvb2ViSEp4M0N6V1FrU29BNWxQQjFXaGh0UERVQ2I2STAK",
      "endpoints": [
        "https://github.com/T1nkiePlayz/Mochi/releases/latest/download/latest.json"
      ]
    }
  }
}
